    "prepublishOnly": "npm run build",
    "contact-monitor": "tsx scripts/contact-monitor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@clack/prompts": "^1.3.0",
