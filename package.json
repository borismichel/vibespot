    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "busboy": "^1.6.0",
    "chalk": "^5.4.1",
    "codemirror": "^6.0.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "mammoth": "^1.11.0",
    "marked": "^18.0.2",
    "pdf-parse": "^2.4.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
