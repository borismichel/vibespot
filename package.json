{
  "name": "vibespot",
  "version": "1.4.2",
  "description": "AI-powered HubSpot CMS landing page builder — vibe coding & React converter",
  "type": "module",
  "bin": {
    "vibespot": "bin/vibespot.mjs"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "assets",
    "ui",
    "starters"
  ],
  "scripts": {
