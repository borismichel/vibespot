# vibeSpot Docker environment variables
# Copy to .env and fill in the values you need.

# ── Server ────────────────────────────────────────────────────
VIBESPOT_PORT=4200

# ── AI Engine (pick one) ──────────────────────────────────────
# Options: anthropic-api, openai-api, gemini-api, langdock-api
# VIBESPOT_AI_ENGINE=anthropic-api

# Set to "true" to enable the multi-stage agentic pipeline (recommended).
# VIBESPOT_AGENTIC_MODE=true

# ── AI API Keys (provide at least one matching your engine) ───
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# Langdock — EU-hosted GDPR-compliant gateway (Frankfurt)
# LANGDOCK_API_KEY=
# LANGDOCK_PROVIDER=               # anthropic | openai | google | mistral (default: anthropic)
# LANGDOCK_BASE_URL=               # override for self-hosted deployments

# ── HubSpot ───────────────────────────────────────────────────
# Personal Access Key for uploading themes to HubSpot.
# HUBSPOT_PERSONAL_ACCESS_KEY=pat-...

# ── Figma ─────────────────────────────────────────────────────
# FIGMA_TOKEN=

# ── HTTPS (used with the Caddy reverse proxy profile) ────────
# Your public domain — Caddy will auto-provision a TLS certificate.
# VIBESPOT_DOMAIN=vibespot.example.com
