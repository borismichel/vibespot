# vibespot docker-compose environment.
# Copy this file to `.env` and fill in the values that apply to your deployment.

# ---------- Image / container -----------------------------------------------
# Image tag to pull. Defaults to `latest`. Pin to a specific version (e.g.
# `v1.3.1`) or a commit SHA for reproducible deploys.
VIBESPOT_IMAGE_TAG=latest

# ---------- Public hostname / TLS -------------------------------------------
# The public domain that Caddy serves. Use `localhost` for local testing —
# Caddy will skip Let's Encrypt and serve over HTTP only.
VIBESPOT_DOMAIN=localhost

# Email address Let's Encrypt uses for cert expiry notices. Required when
# VIBESPOT_DOMAIN is a public hostname; ignored for localhost.
VIBESPOT_TLS_EMAIL=

# Internal upstream that Caddy proxies to. Leave the default unless you renamed
# the vibespot service or changed VIBESPOT_PORT inside the container.
VIBESPOT_UPSTREAM=vibespot:4200

# ---------- AI provider keys ------------------------------------------------
# At least one of these is required for end-to-end landing-page generation.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- Storage adapter -------------------------------------------------
# `filesystem` (default) stores everything under the named volume.
# `postgres` switches to the hosted-mode storage adapter and uses DATABASE_URL.
VIBESPOT_STORAGE=filesystem

# Password for the bundled postgres service. Override in production.
POSTGRES_PASSWORD=vibespot

# ---------- Auth gate (placeholder; enable with --profile auth) -------------
# These are read by oauth2-proxy when the `auth` compose profile is active.
# The actual SSO wiring lands in a sibling issue under VIB-446.
OAUTH2_PROVIDER=oidc
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_COOKIE_SECRET=
OAUTH2_EMAIL_DOMAINS=*
OAUTH2_REDIRECT_URL=
OAUTH2_ISSUER_URL=
