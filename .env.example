# vibeSpot Docker environment variables
# Copy to .env and fill in the values you need.

# ── Server ────────────────────────────────────────────────────
VIBESPOT_PORT=4200

# ── AI Engine (pick one) ──────────────────────────────────────
# Options: anthropic-api, openai-api, gemini-api, langdock-api
# VIBESPOT_AI_ENGINE=anthropic-api

# Set to "true" to enable the multi-stage agentic pipeline (recommended).
# VIBESPOT_AGENTIC_MODE=true

# ── AI API Keys (provide at least one matching your engine) ───
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# Langdock — EU-hosted GDPR-compliant gateway (Frankfurt)
# LANGDOCK_API_KEY=
# LANGDOCK_PROVIDER=               # anthropic | openai | google | mistral (default: anthropic)
# LANGDOCK_BASE_URL=               # override for self-hosted deployments

# ── HubSpot ───────────────────────────────────────────────────
# Personal Access Key for uploading themes to HubSpot.
# HUBSPOT_PERSONAL_ACCESS_KEY=pat-...

# ── Figma ─────────────────────────────────────────────────────
# FIGMA_TOKEN=

# ── HTTPS (used with the Caddy reverse proxy profile) ────────
# Your public domain — Caddy will auto-provision a TLS certificate.
# VIBESPOT_DOMAIN=vibespot.example.com

# ── Azure Entra SSO gate (optional, hosted) ──────────────────
# Restrict the web UI to your org via Entra (Entra ID) single sign-on.
# Enable with the auth overlay:
#   docker compose --profile auth -f docker-compose.yml -f docker-compose.auth.yml up -d
# Setup: create an Entra "App registration", add a Web redirect URI of
#   https://<your-domain>/oauth2/callback, create a client secret, then fill in:
#
# OAUTH2_PROVIDER=oidc
# Tenant-scoped issuer — THIS is what limits login to your company's users:
# OAUTH2_ISSUER_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# OAUTH2_CLIENT_ID=<application (client) id>
# OAUTH2_CLIENT_SECRET=<client secret value>
# OAUTH2_REDIRECT_URL=https://<your-domain>/oauth2/callback
# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
# OAUTH2_COOKIE_SECRET=
# Optional extra filter (defaults to * = any user the tenant allows):
# OAUTH2_EMAIL_DOMAINS=yourcompany.com
# OAUTH2_SCOPE=openid email profile
